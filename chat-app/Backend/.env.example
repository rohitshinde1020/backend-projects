# MongoDB Atlas connection string (without database name in path)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB_NAME=chat-app

# Server
PORT=5000
NODE_ENV=development

# Comma-separated allowed frontend origins (required in production)
FRONTEND_URL=http://localhost:5173

# JWT signing secret (use a long random string in production, min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Cloudinary (profile pictures and message images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
